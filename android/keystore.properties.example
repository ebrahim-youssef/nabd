# Copy to keystore.properties (untracked) on the release machine and fill in.
# Generate the upload keystore once:
#   keytool -genkey -v -keystore nabd-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias nabd-upload
# Then enable Play App Signing in the Play Console and upload with this key.
storeFile=nabd-upload.jks
storePassword=CHANGEME
keyAlias=nabd-upload
keyPassword=CHANGEME
