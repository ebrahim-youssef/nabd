{
  "expo": {
    "name": "نبض",
    "slug": "nabd",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nabd",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Amiri_400Regular.ttf",
            "./assets/fonts/ArefRuqaa_400Regular.ttf",
            "./assets/fonts/Tajawal_400Regular.ttf",
            "./assets/fonts/Tajawal_500Medium.ttf"
          ]
        }
      ],
      "expo-localization",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#eaf2f0",
          "imageWidth": 100,
          "resizeMode": "contain"
        }
      ]
    ],
    "android": {
      "package": "com.nabd.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#eaf2f0"
      }
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3f56668a-2bd1-4158-b730-243df7f75a18"
      }
    }
  }
}
