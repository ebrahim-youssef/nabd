{
  "name": "apps-spa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:assets": "node scripts/generate-assets.mjs",
    "predev": "pnpm generate:assets",
    "dev": "vite",
    "prebuild": "pnpm generate:assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:cloudflare": "pnpm build && node scripts/verify-build.mjs && node scripts/wrangler-dry-run.mjs",
    "preview:cloudflare": "pnpm build && node scripts/verify-build.mjs && wrangler dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm generate:assets",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@nabd/shared": "workspace:*",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@playwright/test": "1.61.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.2",
    "typescript": "^5",
    "vite": "^8.0.10",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
