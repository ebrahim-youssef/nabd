{
  "expo": {
    "name": "نبض",
    "slug": "nabd",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nabd",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يسمح لتطبيق نبض بالوصول إلى موقعك الحالي أثناء استخدام التطبيق."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/thmanyah/thmanyahserifdisplay-Bold.otf",
            "./assets/fonts/thmanyah/thmanyahsans-Regular.otf",
            "./assets/fonts/thmanyah/thmanyahsans-Medium.otf",
            "./assets/fonts/thmanyah/thmanyahsans-Bold.otf",
            "./assets/fonts/thmanyah/thmanyahseriftext-Regular.otf"
          ]
        }
      ],
      "expo-localization",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan_fajr.mp3",
            "./assets/sounds/adhan.mp3",
            "./assets/sounds/before.mp3",
            "./assets/sounds/iqama.mp3"
          ],
          "defaultChannel": "nabd-prayer-adhan-v1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#F5F0E5",
          "imageWidth": 100,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withNabdAlarms",
      "./plugins/withNabdBackup",
      "./plugins/withNabdReleaseSigning",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing"
    ],
    "android": {
      "package": "com.nabd.app",
      "versionCode": 12,
      "allowBackup": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#eaf2f0"
      },
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "router": {
        "origin": false
      }
    }
  }
}
