<?xml version="1.0" encoding="utf-8"?>
<!-- A block that has not opened yet cannot be ticked, so its stars fade. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:drawable="@drawable/nabd_widget_star_on_disabled" android:state_checked="true" android:state_enabled="false" />
  <item android:drawable="@drawable/nabd_widget_star_off_disabled" android:state_enabled="false" />
  <item android:drawable="@drawable/nabd_widget_star_on" android:state_checked="true" />
  <item android:drawable="@drawable/nabd_widget_star_off" />
</selector>
