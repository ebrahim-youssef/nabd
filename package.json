{
  "name": "nabd",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform android",
    "build:apk": "expo prebuild --platform android --clean && node scripts/run-gradle.cjs assembleRelease",
    "build:aab": "expo prebuild --platform android --clean && node scripts/run-gradle.cjs bundleRelease",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check:no-sentry": "node scripts/check-no-sentry.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:native-module": "expo prebuild --platform android --no-install && node scripts/run-gradle.cjs :nabd-device:testReleaseUnitTest",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "adhan": "^4.4.4",
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-intent-launcher": "~57.0.1",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.46.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "postcss": "8.5.19",
    "typescript": "^6.0.3",
    "vite-plus": "1.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.4",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-test-renderer": "19.2.3"
    }
  }
}
